/* ============================================================
   maxima_limits.mac
   Chapter 7 — Functions, Limits and Continuity
   Matzakos, N. (2026). Elements of Linear Algebra, Differential & Integral Calculus. NewTech Publications.
   ============================================================

   COMMANDS USED:
     limit(f, x, a)          → lim_{x→a} f(x)
     limit(f, x, a, plus)    → one-sided limit x→a⁺
     limit(f, x, a, minus)   → one-sided limit x→a⁻
     limit(f, x, inf)        → lim_{x→+∞} f(x)
     limit(f, x, minf)       → lim_{x→-∞} f(x)
     is(f continuous at a)   → test by means of limit
     taylor(f, x, a, n)      → Taylor expansion of order n
     plot2d(f, [x,a,b])      → graph

   Run with: wxMaxima (Load/File) or
                 maxima -b maxima_limits.mac
   ============================================================ */

/* ── Part A: Computing Limits ───────────────────────────── */
print("════ A. Computing Limits ════");

/* Polynomial/rational functions */
print("lim_{x→2} (x²+3x-1) =",
      limit(x^2 + 3*x - 1, x, 2));

print("lim_{x→3} (x²-9)/(x-3) =",
      limit((x^2 - 9)/(x - 3), x, 3));
print("  [= lim (x+3) = 6, the 0/0 form resolved ✓]");

/* A trigonometric limit */
print("lim_{x→0} sin(x)/x =",
      limit(sin(x)/x, x, 0));
print("  [= 1, fundamental limit ✓]");

print("lim_{x→0} (1-cos(x))/x² =",
      limit((1 - cos(x))/x^2, x, 0));
print("  [= 1/2 ✓]");

/* Exponential / logarithmic */
print("lim_{x→0} (e^x - 1)/x =",
      limit((%e^x - 1)/x, x, 0));
print("  [= 1 ✓]");

print("lim_{x→0⁺} x·ln(x) =",
      limit(x * log(x), x, 0, plus));
print("  [= 0, form 0·(-∞) → L'Hôpital ✓]");

/* Limit at infinity */
print("lim_{x→+∞} (3x²-2x+1)/(x²+5) =",
      limit((3*x^2 - 2*x + 1)/(x^2 + 5), x, inf));
print("  [= 3, divide by x² ✓]");

print("lim_{x→+∞} (1 + 1/x)^x =",
      float(limit((1 + 1/x)^x, x, inf)));
print("  [= e ≈ 2.71828 ✓]");

/* ── Part B: One-Sided Limits ───────────────────────────── */
print("════ B. One-Sided Limits ════");

/* |x|/x — jump at 0 */
f_abs : abs(x)/x;
print("lim_{x→0⁺} |x|/x =", limit(f_abs, x, 0, plus));
print("lim_{x→0⁻} |x|/x =", limit(f_abs, x, 0, minus));
print("→ The one-sided limits differ  →  lim_{x→0} does not exist");

/* 1/x — infinity */
print("lim_{x→0⁺} 1/x =", limit(1/x, x, 0, plus));
print("lim_{x→0⁻} 1/x =", limit(1/x, x, 0, minus));

/* floor(x) — integer part */
print("lim_{x→2⁺} floor(x) =", limit(floor(x), x, 2, plus));
print("lim_{x→2⁻} floor(x) =", limit(floor(x), x, 2, minus));

/* ── Part C: Continuity of a Function ───────────────────── */
print("════ C. Continuity ════");

/* Test of continuity: lim = f(a) */
/* f(x) = (x²-4)/(x-2) if x≠2, 4 if x=2 */

f_lim : (x^2 - 4)/(x - 2);
lim_val : limit(f_lim, x, 2);
f_val : 4;   /* the value defined at 2 */
print("f(x) = (x²-4)/(x-2), f(2) = 4");
print("lim_{x→2} f(x) =", lim_val);
print("lim = f(2):", is(lim_val = f_val), "→ continuous at 2 ✓");

/* Discontinuity — jump */
print("");
print("g(x) = 1/x: Discontinuous at 0 (not defined there)");
print("lim_{x→0} 1/x =", limit(1/x, x, 0));

/* ── Part D: L'Hôpital's Rule ───────────────────────────── */
print("════ D. L'Hôpital's Rule ════");

/* Form 0/0 */
h1 : (x^3 - 8)/(x^2 - 4);
print("lim_{x→2} (x³-8)/(x²-4) =", limit(h1, x, 2));
print("  [L'Hôpital: 3x²/(2x)|_{x=2} = 12/4 = 3 ✓]");

/* Form ∞/∞ */
h2 : log(x)/x;
print("lim_{x→∞} ln(x)/x =", limit(h2, x, inf));
print("  [L'Hôpital: (1/x)/1 → 0 ✓]");

/* ── Part E: Taylor Expansion ───────────────────────────── */
print("════ E. Taylor Expansion ════");

print("sin(x) about 0 (order 5):");
print(taylor(sin(x), x, 0, 5));

print("e^x about 0 (order 4):");
print(taylor(%e^x, x, 0, 4));

print("ln(1+x) about 0 (order 4):");
print(taylor(log(1+x), x, 0, 4));

print("════ End ════");
