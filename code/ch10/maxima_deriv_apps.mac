/* ============================================================
   maxima_deriv_apps.mac
   Chapter 9 — Applications of the Derivative
   Matzakos, N. (2026). Elements of Linear Algebra, Differential & Integral Calculus. NewTech Publications.
   ============================================================

   COMMANDS USED:
     diff(f, x)           → derivative
     solve(eq, x)         → critical points (f'=0)
     realroots(p, eps)    → numerical roots of a polynomial
     sign(expr)           → sign of an expression
     at(expr, x=a)        → evaluation at a
     subst(a, x, expr)    → substitution
     plot2d               → graph

   Run with: wxMaxima (Load/File) or
                 maxima -b maxima_deriv_apps.mac
   ============================================================ */

/* ── Part A: Monotonicity & Local Extrema ──────────────── */
print("════ A. Monotonicity & Local Extrema ════");

f  : x^3 - 3*x^2 - 9*x + 5;
fp : diff(f, x);
fpp: diff(f, x, 2);

print("f(x)  =", f);
print("f'(x) =", fp);
print("f''(x)=", fpp);

/* Critical points: f'=0 */
crit : solve(fp = 0, x);
print("Critical points (f'=0):", crit);

/* Second derivative test */
for cr in crit do (
    xc : rhs(cr),
    fc : subst(xc, x, f),
    sc : subst(xc, x, fpp),
    print("  x =", xc, "  f(x) =", fc, "  f''(x) =", sc,
          if sc > 0 then "  → LOCAL MINIMUM"
          elseif sc < 0 then "  → LOCAL MAXIMUM"
          else "  → Inconclusive")
);

/* Monotonicity */
print("Monotonicity:");
print("  f'(x) =", factor(fp));
print("  f'(x) = 3(x-3)(x+1)");
print("  f'>0 if x<-1 or x>3  →  f increasing");
print("  f'<0 if -1<x<3       →  f decreasing");

/* ── Part B: Convexity & Inflection Points ─────────────── */
print("════ B. Convexity & Inflection Points ════");

inflect : solve(fpp = 0, x);
print("Inflection points (f''=0):", inflect);

for inf in inflect do (
    xi : rhs(inf),
    fi : subst(xi, x, f),
    print("  Inflection point: (", xi, ",", fi, ")")
);

print("  x<1: f''>0 → convex ↑");
print("  x>1: f''<0 → concave ∩");

/* ── Part C: Optimization ───────────────────────────────── */
print("════ C. An Optimization Problem ════");

/* Rectangle of maximum area with perimeter P=20
   E = x*y, x+y=10 → E(x)=x*(10-x) */
P : 20;
E : x * (P/2 - x);
Ep: diff(E, x);
x_opt : rhs(solve(Ep=0, x)[1]);
E_opt : subst(x_opt, x, E);
y_opt : P/2 - x_opt;

print("Rectangle of maximum area (P=20):");
print("  E(x) = x(10-x)  →  E'(x) =", Ep);
print("  x* =", x_opt, "  y* =", y_opt);
print("  E_max =", E_opt, "  (a square ✓)");

/* Open box without a lid: minimizing the material
   V = x²h = 32, S = x² + 4xh → substitute h=32/x² */
print("");
print("Box (V=32, minimum surface area):");
assume(x > 0)$
h_expr : 32 / x^2;
S_expr : x^2 + 4*x*h_expr;
S_expr : ratsimp(S_expr);
print("  S(x) =", S_expr);
Sp : diff(S_expr, x);
x_box : rhs(solve(Sp=0, x)[1]);
h_box : subst(x_box, x, h_expr);
S_min : subst(x_box, x, S_expr);
print("  x* =", float(x_box), "  h* =", float(h_box));
print("  S_min =", float(S_min));

/* ── Part D: The Mean Value Theorem ───────────────────── */
print("════ D. The Mean Value Theorem (MVT) ════");

/* f(x)=x²-x+1 on [1,4]: find c such that f'(c)=(f(4)-f(1))/(4-1) */
f_mvt : x^2 - x + 1;
a_m : 1;  b_m : 4;
slope : (subst(b_m, x, f_mvt) - subst(a_m, x, f_mvt)) / (b_m - a_m);
fp_mvt : diff(f_mvt, x);
c_val : rhs(solve(fp_mvt = slope, x)[1]);
print("f(x) = x²-x+1 on [1,4]");
print("Mean slope:", slope);
print("f'(c) =", slope, "  →  c =", c_val);
print("c ∈ [1,4]:", is(a_m < c_val and c_val < b_m));

/* ── Part E: The Newton-Raphson Method ───────────────────── */
print("════ E. The Newton-Raphson Method ════");

/* Finding the root of x³-x-2=0 near x=1.5 */
f_nr : x^3 - x - 2;
fp_nr: diff(f_nr, x);
print("f(x) = x³-x-2,  f'(x) =", fp_nr);

x_nr : 1.5;
for i : 1 thru 5 do (
    fx  : float(subst(x_nr, x, f_nr)),
    fpx : float(subst(x_nr, x, fp_nr)),
    x_nr_new : x_nr - fx/fpx,
    print("  Iteration", i, ": x =", float(x_nr_new), "  f(x) =",
          float(subst(x_nr_new, x, f_nr))),
    x_nr : x_nr_new
);
print("  Convergence: x* ≈", float(x_nr));

print("════ End ════");
