/* ============================================================
   maxima_deriv.mac
   Chapter 8 — The Derivative
   Matzakos, N. (2026). Elements of Linear Algebra, Differential & Integral Calculus. NewTech Publications.
   ============================================================

   COMMANDS USED:
     diff(f, x)          → f'(x)  (first derivative)
     diff(f, x, n)       → f⁽ⁿ⁾(x)  (nth derivative)
     diff(f, x, 1), ...  → partial derivatives
     at(expr, x=a)       → evaluation at x=a
     subst(a, x, f)      → substitution x=a in f
     ratsimp / trigsimp  → simplification
     solve(eq, x)        → finding critical points

   Run with: wxMaxima (Load/File) or
                 maxima -b maxima_deriv.mac
   ============================================================ */

/* ── Part A: Basic Derivatives ─────────────────────────── */
print("════ A. Basic Derivatives ════");

/* Polynomials */
f1 : 3*x^4 - 5*x^2 + 2*x - 7;
print("f(x) =", f1);
print("f'(x) =", diff(f1, x));
print("f''(x) =", diff(f1, x, 2));

/* Trigonometric */
print("");
print("d/dx[sin(x)] =", diff(sin(x), x));
print("d/dx[cos(x)] =", diff(cos(x), x));
print("d/dx[tan(x)] =", trigsimp(diff(tan(x), x)));
print("d/dx[sin²(x)] =", trigsimp(diff(sin(x)^2, x)));

/* Exponential / logarithmic */
print("");
print("d/dx[e^x]   =", diff(%e^x, x));
print("d/dx[e^(3x)]=", diff(%e^(3*x), x));
print("d/dx[ln(x)] =", diff(log(x), x));
print("d/dx[ln(x²+1)]=", ratsimp(diff(log(x^2+1), x)));
print("d/dx[aˣ]    =", diff(a^x, x));   /* a>0, a≠1 */

/* ── Part B: Differentiation Rules ────────────────────── */
print("════ B. Differentiation Rules ════");

f : x^2 * sin(x);
g : (x^3 + 1) / (x^2 - 1);
h : sin(x^2 + 1);    /* composite */

print("Product rule: d/dx[x²·sin x] =", expand(diff(f, x)));
print("Quotient rule: d/dx[(x³+1)/(x²-1)] =", ratsimp(diff(g, x)));
print("Chain rule: d/dx[sin(x²+1)] =", diff(h, x));

/* Step-by-step check of the chain rule */
u : x^2 + 1;   /* inner function */
print("  Step 1: du/dx =", diff(u, x));
print("  Step 2: d/du[sin u] =", diff(sin(u), u));
print("  Chain: cos(u)·2x = cos(x²+1)·2x ✓");

/* ── Part C: Higher-Order Derivatives ──────────────────── */
print("════ C. Higher-Order Derivatives ════");

f_e : %e^x * cos(x);
print("f(x) = eˣcos(x)");
print("f'(x)  =", trigsimp(diff(f_e, x)));
print("f''(x) =", trigsimp(diff(f_e, x, 2)));
print("f'''(x)=", trigsimp(diff(f_e, x, 3)));
print("f⁽⁴⁾(x)=", trigsimp(diff(f_e, x, 4)));
print("  [Expected: -4·eˣcos(x) = -4·f(x)]");
print("  Check:", ratsimp(diff(f_e,x,4) + 4*f_e));

/* ── Part D: The Derivative from the Definition ────────── */
print("════ D. The Derivative from the Definition ════");

/* f'(x) = lim_{h→0} [f(x+h)-f(x)]/h */
f_def : x^2;
h_var : h;
diff_def : limit((subst(x+h_var, x, f_def) - f_def)/h_var, h_var, 0);
print("Definition: d/dx[x²] =", diff_def, "  (= 2x ✓)");

f_def2 : sqrt(x);
diff_def2 : ratsimp(limit((subst(x+h_var,x,f_def2)-f_def2)/h_var, h_var, 0));
print("Definition: d/dx[√x] =", diff_def2, "  (= 1/(2√x) ✓)");

/* ── Part E: Tangent & Normal Line ─────────────────────── */
print("════ E. The Tangent Line ════");

f_tan : x^3 - 2*x + 1;
x0 : 1;
y0 : subst(x0, x, f_tan);
m  : subst(x0, x, diff(f_tan, x));

print("f(x) = x³ - 2x + 1,  x₀ =", x0);
print("f(x₀) =", y0, "   f'(x₀) =", m);
print("Tangent: y =", m*(x-x0)+y0, "  (y =", m, "x +", y0-m*x0, ")");
print("Normal:  y =", -1/m*(x-x0)+y0);

/* ── Part F: Logarithmic Differentiation ────────────────── */
print("════ F. Logarithmic Differentiation ════");

/* y = x^x → ln y = x·ln x → y'/y = ln x + 1 → y' = x^x(ln x+1) */
assume(x > 0)$
y_log : x^x;
print("y = xˣ");
print("d/dx[xˣ] =", diff(y_log, x));
print("  [= xˣ·(ln x + 1) ✓]");

/* Composite: y = (sin x)^(cos x) */
y_log2 : sin(x)^cos(x);
print("d/dx[(sin x)^(cos x)] =",
      trigsimp(diff(y_log2, x)));

print("════ End ════");
